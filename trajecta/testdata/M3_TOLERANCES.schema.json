{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trajecta.dev/schema/m3-tolerances-v1.json",
  "title": "Trajecta M3 frozen comparison tolerance registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm_id",
    "registry_version",
    "approved_at_utc",
    "approval_authority",
    "calibration_report",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "trajecta.m3.tolerances/v1"
    },
    "algorithm_id": {
      "const": "trajecta/met_query/m3/v0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "approved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "approval_authority": {
      "const": "A"
    },
    "calibration_report": {
      "$ref": "#/$defs/calibration_report"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calibration_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "state"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "state": {
          "enum": ["measured_partial", "measured_complete"]
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_families",
        "comparison_target",
        "comparison_variant",
        "sample_scope",
        "field_namespace",
        "fields",
        "coordinates",
        "vertical_regions"
      ],
      "properties": {
        "dataset_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "analytic",
              "era5_hybrid",
              "era5_pressure",
              "cfsr_pressure"
            ]
          }
        },
        "comparison_target": {
          "enum": [
            "analytic_formula",
            "backend_equivalence",
            "format_equivalence",
            "cross_platform",
            "flexpart_common_semantics",
            "flexpart_difference_report"
          ]
        },
        "comparison_variant": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "sample_scope": {
          "enum": [
            "decoded_field",
            "native_anchor",
            "interpolated_common",
            "surface_layer",
            "modern_difference"
          ]
        },
        "field_namespace": {
          "enum": ["source_identity", "canonical_field", "transport_output"]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["all", "asl", "agl", "pressure_pa", "native_level"]
          }
        },
        "vertical_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["all", "surface_layer", "upper_air"]
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "selector",
        "decision",
        "exact_metadata",
        "mask_policy",
        "non_finite_policy",
        "metric",
        "threshold_basis",
        "evidence_ids",
        "scientific_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "decision": {
          "enum": ["hard_gate", "report_only"]
        },
        "exact_metadata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "valid_times",
              "grid",
              "vertical_topology",
              "layout",
              "mask",
              "unit",
              "temporal_support",
              "status",
              "validity"
            ]
          }
        },
        "mask_policy": {
          "const": "exact"
        },
        "non_finite_policy": {
          "const": "reject"
        },
        "metric": {
          "oneOf": [
            {
              "$ref": "#/$defs/absolute_relative"
            },
            {
              "$ref": "#/$defs/ulp"
            },
            {
              "$ref": "#/$defs/exact"
            },
            {
              "$ref": "#/$defs/vector"
            }
          ]
        },
        "threshold_basis": {
          "enum": [
            "measured_envelope",
            "preregistered_precision_budget",
            "diagnostic_scale"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scientific_reason": {
          "type": "string",
          "minLength": 30
        },
        "allowlist_issue": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "report_only"
              }
            },
            "required": ["decision"]
          },
          "then": {
            "required": ["allowlist_issue"]
          },
          "else": {
            "not": {
              "required": ["allowlist_issue"]
            }
          }
        }
      ]
    },
    "absolute_relative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "absolute", "relative", "scale_floor"],
      "properties": {
        "kind": {
          "const": "absolute_relative"
        },
        "absolute": {
          "type": "number",
          "minimum": 0
        },
        "relative": {
          "type": "number",
          "minimum": 0
        },
        "scale_floor": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "ulp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "maximum_ulps", "signed_zero_equal"],
      "properties": {
        "kind": {
          "const": "ulp"
        },
        "maximum_ulps": {
          "type": "integer",
          "minimum": 0
        },
        "signed_zero_equal": {
          "type": "boolean"
        }
      }
    },
    "exact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "equality", "signed_zero_equal"],
      "properties": {
        "kind": {
          "const": "exact"
        },
        "equality": {
          "enum": ["numeric", "bitwise"]
        },
        "signed_zero_equal": {
          "type": "boolean"
        }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "component_absolute",
        "component_relative",
        "component_scale_floor",
        "speed_floor",
        "direction_degrees"
      ],
      "properties": {
        "kind": {
          "const": "vector"
        },
        "component_absolute": {
          "type": "number",
          "minimum": 0
        },
        "component_relative": {
          "type": "number",
          "minimum": 0
        },
        "component_scale_floor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed_floor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "direction_degrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        }
      }
    }
  }
}
