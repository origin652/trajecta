{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trajecta.dev/schema/m5-cli-output-v1.json",
  "title": "Trajecta single-result CLI envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "ok", "data", "diagnostics"],
  "properties": {
    "schema_version": { "const": "trajecta.cli-output/v1" },
    "command": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "run_success": { "type": "boolean" },
    "data": true,
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "path", "hint"],
      "properties": {
        "severity": { "enum": ["error", "warning", "info"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "path": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": { "enum": ["field", "index"] },
              "value": {}
            }
          }
        },
        "hint": { "type": ["string", "null"] }
      }
    }
  }
}
