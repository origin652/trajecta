{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trajecta.dev/schema/m3-comparison-report-v1.json",
  "title": "Trajecta M3 tolerance adjudication report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "algorithm_id",
    "registry",
    "comparison",
    "status",
    "coverage",
    "results",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": "trajecta.m3.comparison_report/v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "algorithm_id": {
      "const": "trajecta/met_query/m3/v0"
    },
    "registry": {
      "$ref": "#/$defs/registry_identity"
    },
    "comparison": {
      "$ref": "#/$defs/comparison_identity"
    },
    "status": {
      "enum": ["passed", "failed", "incomplete", "unvalidated"]
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          },
          "results": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registry_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "comparison_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_family",
        "comparison_target",
        "comparison_variant",
        "subject_sha256",
        "reference_sha256"
      ],
      "properties": {
        "dataset_family": {
          "enum": ["analytic", "era5_hybrid", "era5_pressure", "cfsr_pressure"]
        },
        "comparison_target": {
          "enum": [
            "analytic_formula",
            "backend_equivalence",
            "format_equivalence",
            "cross_platform",
            "flexpart_common_semantics",
            "flexpart_difference_report"
          ]
        },
        "comparison_variant": {
          "type": "string",
          "minLength": 1
        },
        "subject_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_case_ids", "observed_case_ids", "missing_case_ids"],
      "properties": {
        "expected_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "field",
        "decision",
        "status",
        "compared_count",
        "invalid_count",
        "numeric_failure_count",
        "metadata_failure_count",
        "non_finite_count",
        "statistics"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": ["hard_gate", "report_only"]
        },
        "status": {
          "enum": ["pass", "fail", "reported", "unvalidated"]
        },
        "compared_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "numeric_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "non_finite_count": {
          "type": "integer",
          "minimum": 0
        },
        "statistics": {
          "$ref": "#/$defs/statistics"
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact_mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_absolute_difference": {
          "type": "number",
          "minimum": 0
        },
        "maximum_relative_difference": {
          "type": "number",
          "minimum": 0
        },
        "maximum_ulps": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_direction_degrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "worst_case_id": {
          "type": "string",
          "minLength": 1
        },
        "worst_subject_value": {
          "type": "number"
        },
        "worst_reference_value": {
          "type": "number"
        }
      }
    }
  }
}
