  "failure_policy": {
    "missing_auxiliary_data": "preflight_error_no_runtime_download",
    "invalid_nonnegative_allocation": "run_fatal",
    "substep_underflow": "run_fatal",
    "unsupported_legacy_physics": "configuration_error_with_field_path"
  },
  "excluded_scope": [
    "aerosol_ageing",
    "canopy_exchange",
    "complex_chemical_networks",
    "mountain_waves",
    "multiphase_chemistry",
    "resuspension",
    "sea_salt_generation",
    "wakes"
  ]
}
