      "fallback_paths": [
        "target/test-data/era5-cf-hybrid-netcdf4"
      ],
      "conversion_steps": [
        "cargo run -p trajecta-met --example grib_to_cf_netcdf -- --input <EA181201xx GRIB> --output target/test-data/era5-cf-hybrid-netcdf3-classic/<EA>.nc --family era5_cf_hybrid_netcdf4",
