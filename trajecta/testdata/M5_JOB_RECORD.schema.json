{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trajecta.dev/schema/m5-job-record-v1.json",
  "title": "Trajecta durable job-attempt record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_series_id",
    "run_id",
    "attempt",
    "state",
    "input",
    "resources",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "trajecta.job-record/v1" },
    "job_series_id": { "$ref": "#/$defs/uuidV7" },
    "run_id": { "$ref": "#/$defs/uuidV7" },
    "attempt": { "type": "integer", "minimum": 1 },
    "state": { "$ref": "#/$defs/state" },
    "input": { "$ref": "#/$defs/input" },
    "resources": { "$ref": "#/$defs/resources" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "queue_position": { "type": "integer", "minimum": 0 },
    "output_directory": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "complete",
              "completed_with_particle_errors",
              "failed",
              "cancelled",
              "interrupted"
            ]
          }
        }
      },
      "then": { "required": ["finished_at"] },
      "else": { "not": { "required": ["finished_at"] } }
    },
    {
      "if": { "properties": { "state": { "const": "queued" } } },
      "else": { "not": { "required": ["queue_position"] } }
    }
  ],
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-7[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
    },
    "state": {
      "enum": [
        "queued",
        "starting",
        "running",
        "cancelling",
        "complete",
        "completed_with_particle_errors",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seconds_since_unix_epoch", "nanosecond"],
      "properties": {
        "seconds_since_unix_epoch": { "type": "integer" },
        "nanosecond": { "type": "integer", "minimum": 0, "maximum": 999999999 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_slots", "memory_mib", "worker_threads"],
      "properties": {
        "cpu_slots": { "type": "integer", "minimum": 1 },
        "memory_mib": { "type": "integer", "minimum": 1 },
        "worker_threads": { "type": "integer", "minimum": 1 }
      }
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "project_root", "profile_name"],
          "properties": {
            "mode": { "const": "project" },
            "project_root": { "type": "string", "minLength": 1 },
            "profile_name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "case_path", "run_profile_path"],
          "properties": {
            "mode": { "const": "direct" },
            "case_path": { "type": "string", "minLength": 1 },
            "run_profile_path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
